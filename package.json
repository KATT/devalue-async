{
	"name": "devalue-async",
	"version": "0.7.2",
	"description": "Extension of the great devalue-package with ability to handle async values",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/KATT/devalue-async.git"
	},
	"license": "MIT",
	"author": {
		"name": "KATT",
		"url": "https://katt.dev"
	},
	"type": "module",
	"exports": {
		".": {
			"types": {
				"import": "./lib/index.d.ts",
				"require": "./lib/index.d.cts"
			},
			"import": "./lib/index.js",
			"require": "./lib/index.cjs"
		}
	},
	"files": [
		"LICENSE.md",
		"README.md",
		"lib",
		"package.json",
		"src",
		"!**/*.test.*",
		"!**/test.*"
	],
	"scripts": {
		"build": "tsdown",
		"format": "prettier . --write",
		"lint": "run-p lint:* --print-label",
		"lint:eslint": "eslint . --max-warnings 0",
		"lint:knip": "knip",
		"lint:md": "markdownlint \"**/*.md\" \".github/**/*.md\" --rules sentences-per-line",
		"lint:packages": "pnpm dedupe --check",
		"lint:spelling": "cspell \"**\" \".github/**/*\"",
		"prepare": "husky",
		"test": "vitest",
		"tsc": "tsc"
	},
	"lint-staged": {
		"*": "prettier --ignore-unknown --write"
	},
	"devDependencies": {
		"@eslint-community/eslint-plugin-eslint-comments": "4.7.2",
		"@eslint/js": "9.39.1",
		"@release-it/conventional-changelog": "12.0.0",
		"@types/eslint-plugin-markdown": "2.0.2",
		"@types/node": "24.13.3",
		"@vitest/coverage-v8": "4.1.10",
		"@vitest/eslint-plugin": "1.6.1",
		"console-fail-test": "0.6.0",
		"cspell": "10.2.0",
		"devalue": "^5.5.0",
		"eslint": "9.39.1",
		"eslint-plugin-jsdoc": "64.3.1",
		"eslint-plugin-jsonc": "3.4.1",
		"eslint-plugin-markdown": "5.1.0",
		"eslint-plugin-n": "18.3.0",
		"eslint-plugin-package-json": "0.54.0",
		"eslint-plugin-perfectionist": "5.11.0",
		"eslint-plugin-regexp": "3.2.0",
		"eslint-plugin-yml": "3.8.1",
		"husky": "9.1.7",
		"knip": "5.88.1",
		"lint-staged": "17.4.1",
		"markdownlint": "0.41.1",
		"markdownlint-cli": "0.49.1",
		"npm-run-all2": "9.0.3",
		"prettier": "3.9.6",
		"prettier-plugin-curly": "0.4.0",
		"prettier-plugin-packagejson": "3.0.0",
		"prettier-plugin-sh": "0.19.0",
		"release-it": "21.0.2",
		"sentences-per-line": "0.3.0",
		"tsdown": "^0.15.0",
		"typescript": "5.9.2",
		"typescript-eslint": "8.69.0",
		"vitest": "4.1.10"
	},
	"peerDependencies": {
		"devalue": "^5.0.0"
	},
	"packageManager": "pnpm@11.25.0",
	"engines": {
		"node": ">=18.3.0"
	},
	"publishConfig": {
		"provenance": true
	}
}
